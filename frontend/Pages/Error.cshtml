@page "/Error"
@model DataCleanPro.Pages.ErrorModel
@{
    // Fix #L: minimal layout — no Blazor circuit on the error page
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>Error — DataCleanPro</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet"/>
    <style>
        body{margin:0;font-family:Inter,sans-serif;background:#F5F6FA;display:flex;align-items:center;justify-content:center;min-height:100vh;}
        .card{background:white;border-radius:16px;padding:48px;box-shadow:0 4px 24px rgba(0,0,0,.08);max-width:460px;text-align:center;}
        .icon{width:72px;height:72px;background:#FBE9E7;border-radius:18px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;}
        h1{color:#1a237e;font-size:1.5rem;font-weight:800;margin:0 0 10px;}
        p{color:#78909C;font-size:.88rem;line-height:1.6;margin:0 0 20px;}
        code{display:block;background:#F5F6FA;padding:8px 14px;border-radius:8px;font-size:.78rem;color:#3949AB;margin-bottom:24px;}
        a{display:inline-block;padding:12px 28px;background:#3949AB;color:white;border-radius:10px;text-decoration:none;font-weight:600;font-size:.9rem;}
        a:hover{background:#283593;}
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="#F4511E">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
        </div>
        <h1>Something went wrong</h1>
        <p>An unexpected error occurred. Check that the Python backend is running on port 8765.</p>
        @if (Model.ShowRequestId)
        {
            <code>Request ID: @Model.RequestId</code>
        }
        <a href="/">Back to Dashboard</a>
    </div>
</body>
</html>
